NODE_ENV=production
# PORT is provided by the host (Render). Only set it locally.
PUBLIC_ORIGIN=https://your-app.onrender.com
NEXT_PUBLIC_API_URL=https://your-app.onrender.com
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=aviator
REDIS_URL=
JWT_SECRET=            # openssl rand -base64 48
JWT_EXPIRES_IN=12h
FAIR_CHAIN_ROOT=       # openssl rand -hex 32  (secret! never share, never change once live)
FAIR_CHAIN_LENGTH=100000
FAIR_CLIENT_SEED=change-me-public-string
PAYHERO_CHANNEL_ID=
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_CALLBACK_SECRET=   # openssl rand -hex 32
PAYHERO_VERIFY_WITH_API=true
HOUSE_EDGE_PERCENT=20
MIN_BET=10
MAX_BET=100000
MAX_MULTIPLIER=1000
MAX_PAYOUT=500000
DEFAULT_CURRENCY=KES
ADMIN_EMAIL=
ADMIN_PASSWORD=
MIN_DEPOSIT=10
MIN_WITHDRAWAL=100
